# Copy to .env and fill in before streaming
YT_RTMP_URL=rtmps://a.rtmp.youtube.com/live2/xcuz-3x1d-9y7v-ghec-2xmh
AUDIO_GAIN_DB=8
AUDIO_MODE=speech
AUDIO_HIGHPASS=120

# Encoder preferences (comma-separated)
PREFERRED_ENCODERS=h264_v4l2m2m,libx264

# Force software (emergency switch)
USE_SW_ENC=0     # set to 1 to force libx264

# Bitrate tuning
VIDEO_BITRATE=3500k
VIDEO_MAXRATE=4000k
VIDEO_BUFSIZE=6000k

# Recording control
RECORD_MP4=1
