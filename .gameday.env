YOUTUBE_RTMP_URL=rtmps://a.rtmps.youtube.com/live2/xcuz-3x1d-9y7v-ghec-2xmh
AUDIO_INPUT=alsa
ALSA_DEV=plughw:2,0
AF_CHAIN=highpass=f=100,dynaudnorm=m=50:s=10:p=0.6,alimiter=limit=-0.3dB:attack=5,aresample=async=1:min_hard_comp=0.1:first_pts=0
# Fill canvas: normalize SAR -> scale up to cover -> crop to exact WxH -> 30fps
VIDEO_SIZE=1280x720
# Fill canvas: normalize SAR -> scale up to fully cover -> crop to 1280:720 -> fps
VF_CHAIN=scale=in_range=full:out_range=tv,format=yuv420p,scale=iw*sar:ih,setsar=1,scale=${VF_SIZE_COLON}:flags=bicubic:force_original_aspect_ratio=increase,crop=${VF_SIZE_COLON},fps=${FRAME_RATE},setpts=PTS-STARTPTS
