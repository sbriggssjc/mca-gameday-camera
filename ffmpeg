#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

# Find the real ffmpeg (skip this shim). Fallback to /usr/bin/ffmpeg.
real="$(command -v -a ffmpeg | sed -n '2p' || true)"
real="${real:-/usr/bin/ffmpeg}"

args=( "$@" )

has() {
  for a in "${args[@]}"; do [[ "$a" == "$1" ]] && return 0; done
  return 1
}

# detect -input_format h264
is_h264=false
for ((i=0;i<${#args[@]}-1;i++)); do
  if [[ "${args[i]}" == "-input_format" && "${args[i+1]}" == "h264" ]]; then
    is_h264=true; break
  fi
done

# detect -c:v copy
is_copy=false
for ((i=0;i<${#args[@]}-1;i++)); do
  if [[ "${args[i]}" == "-c:v" && "${args[i+1]}" == "copy" ]]; then
    is_copy=true; break
  fi
done

# Insert -copyts -start_at_zero just before the first "-f tee"
# only when input is h264 and we're copying video, and -copyts isn't already present
if $is_h264 && $is_copy && ! has "-copyts"; then
  insert=${#args[@]}
  for ((i=0;i<${#args[@]}-1;i++)); do
    if [[ "${args[i]}" == "-f" && "${args[i+1]}" == "tee" ]]; then
      insert=$i; break
    fi
  done
  args=( "${args[@]:0:insert}" "-copyts" "-start_at_zero" "${args[@]:insert}" )
fi

# Optional debug
if [[ "${FFMPEG_SHIM_DEBUG:-}" == "1" ]]; then
  printf 'shim: exec %q' "$real" >&2
  for a in "${args[@]}"; do printf ' %q' "$a" >&2; done
  printf '\n' >&2
fi

exec "$real" "${args[@]}"
