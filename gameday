#!/usr/bin/env bash
set -euo pipefail

if [[ "${1-}" == "--self-test" ]]; then
  echo "🔎 Probing encoders..."
  tools/encoder_detect.py "${PREFERRED_ENCODERS-}" || { echo "❌ No encoder works"; exit 1; }
  echo "✅ Selected: $(tools/encoder_detect.py "${PREFERRED_ENCODERS-}")"
  exit 0
fi

exec "$(dirname "$0")/scripts/gameday_launcher.sh"
