#!/usr/bin/env bash
# Prevent committing huge files or recordings
MAX=$((50 * 1024 * 1024))
fail=0
while read -r file; do
  [ -f "$file" ] || continue
  if [[ "$file" == video/* || "$file" == recordings/* ]]; then
    echo "pre-commit: refusing to commit $file" >&2
    fail=1
    continue
  fi
  size=$(stat -c%s "$file")
  if [ "$size" -gt "$MAX" ]; then
    echo "pre-commit: $file is larger than 50MB" >&2
    fail=1
  fi
done < <(git diff --cached --name-only)
exit $fail
